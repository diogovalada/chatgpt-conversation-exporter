{
  "manifest_version": 3,
  "name": "AI Conversation Exporter",
  "version": "0.4.4",
  "description": "Export ChatGPT and Claude conversations to Markdown (.md) or a zip with images.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Export conversation",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "permissions": ["downloads", "storage"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://images.openai.com/*",
    "https://claude.ai/*",
    "https://assets-proxy.anthropic.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
      "js": ["content/providers/chatgpt-page-fetch.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
      "js": [
        "content/shared.js",
        "content/provider-registry.js",
        "content/markdown-converter.js",
        "content/extraction.js",
        "content/sidebar-panel.js",
        "content/providers/chatgpt-data.js",
        "content/providers/chatgpt.js",
        "content/content_main.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://claude.ai/*"],
      "js": ["content/providers/claude-page-fetch.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://claude.ai/*"],
      "js": [
        "content/shared.js",
        "content/provider-registry.js",
        "content/markdown-converter.js",
        "content/extraction.js",
        "content/sidebar-panel.js",
        "content/providers/claude-data.js",
        "content/providers/claude.js",
        "content/content_main.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
